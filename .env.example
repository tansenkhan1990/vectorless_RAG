# Vectorless RAG Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# LLM Configuration
# ============================================

# For Local Models (Ollama)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama

# For OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# Model Selection
# ============================================

# Model to use for answering questions
# Examples: "qwen3-vl:235b-cloud", "gpt-4", "claude-3-sonnet-20240229"
LOCAL_MODEL_NAME=qwen3-vl:235b-cloud

# Embedding model for semantic search
LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest

# ============================================
# Supabase Configuration
# ============================================

# Your Supabase project URL
# Format: https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase publishable key (starts with sb_)
# This can be found in Project Settings > API
SUPABASE_KEY=sb_your_publishable_key_here

# ============================================
# Optional: OpenAI Agents Settings
# ============================================

# Disable telemetry (recommended for privacy)
OPENAI_AGENTS_DISABLE_TRACING=1
OPENAI_DISABLE_TELEMETRY=true

# ============================================
# Instructions:
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. Keep .env private - never commit to git
# 4. For local development, use Ollama
# 5. For production, use OpenAI API key
# ============================================
